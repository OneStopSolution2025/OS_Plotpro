# Copy this to .env and fill in real values. Never commit the real .env.

# Railway gives you this directly under your Postgres service's "Connect" tab.
# NOTE: Railway's default URL starts with postgresql:// — change it to
# postgresql+asyncpg:// for this project since we use the async driver.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/plotpro

JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

PLATFORM_ADMIN_EMAIL=admin@os2studio.com
ENV=development
